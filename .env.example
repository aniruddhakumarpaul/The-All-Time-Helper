# Copy this file to .env and fill only local/private values.
# Never commit your real .env file.

# Core security
SECRET_KEY=change-this-local-secret
ADMIN_KEY=change-this-admin-key

# Database
DB_FILE=users.db

# Cloud model routing through OpenRouter
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_FREE_MAX_TOKENS=2048
OPENROUTER_MAX_TOKENS=4096

# Local Ollama
OLLAMA_URL=http://localhost:11434

# Email mode
# Use SIMULATE until SMTP is fully tested.
EMAIL_MODE=SIMULATE
SENDER_EMAIL=
SENDER_PWD=

# Optional local tunnel
# Keep disabled unless you specifically need public access.
ENABLE_NGROK=false
NGROK_TOKEN=
# Optional: set when pyngrok cannot install or execute its bundled ngrok binary on Windows.
# Example: NGROK_PATH=C:\Tools\ngrok\ngrok.exe
NGROK_PATH=

# Optional CORS origins
ALLOWED_ORIGINS=http://localhost:9000

# Application-owned OpenTelemetry. Export is disabled unless explicitly enabled.
HELPER_OTEL_ENABLED=false
OTEL_SERVICE_NAME=all-time-helper
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Optional, application-owned read-only MCP server. Blank endpoint disables it.
# Only the version-controlled GitHub alias and read-tool bindings are callable.
MCP_GITHUB_URL=
MCP_GITHUB_TOKEN=
# Install the MCP 2.2 client in an isolated target directory to preserve CrewAI's mcp 1.x dependency.
MCP_SDK_V2_PACKAGE_DIR=.runtime/mcp-sdk
# Optional; defaults to the same Python executable running FastAPI.
MCP_SDK_V2_PYTHON=
# Discovery cache is clamped to 60-300 seconds; tool exposure is clamped to 12.
MCP_DISCOVERY_TTL_SECONDS=120
MCP_MAX_TOOLS_PER_REQUEST=12

# Privacy-safe local provider usage ledger
HELPER_USAGE_LEDGER_ENABLED=true
USAGE_DB_FILE=.runtime/usage.db
USAGE_RETENTION_DAYS=30
USAGE_MAX_EVENTS=100000
USAGE_MAX_STORAGE_BYTES=67108864

# Durable chat jobs
# SQLite is the supported local multi-worker/restart backend. Use memory only for isolated tests.
CHAT_JOB_BACKEND=sqlite
CHAT_JOB_DB_FILE=.runtime/chat_jobs.db
CHAT_JOB_RETENTION_SECONDS=3600
CHAT_JOB_MAX_EVENT_BYTES=32768
CHAT_JOB_MAX_CONTENT_CHARS=120000
CHAT_JOB_MAX_CONTENT_BYTES=2097152
CHAT_JOB_MAX_EVENT_STORAGE_BYTES=2097152
CHAT_JOB_MAX_EVENTS=2000
CHAT_JOB_MAX_RETAINED_JOBS=500
CHAT_JOB_MAX_STORAGE_BYTES=67108864
CHAT_JOB_CANCEL_POLL_SECONDS=0.4
CHAT_JOB_LEASE_SECONDS=30
CHAT_JOB_LEASE_RENEW_SECONDS=5
CHAT_JOB_LAUNCH_SECONDS=15

# Durable multi-step workflows
# SQLite WAL coordinates workflow/action claims across local workers. Credentials are never stored.
WORKFLOW_DB_FILE=.runtime/workflows.db
WORKFLOW_RETENTION_SECONDS=86400
WORKFLOW_APPROVAL_TTL_SECONDS=600
WORKFLOW_LEASE_SECONDS=30
WORKFLOW_LEASE_RENEW_SECONDS=5
WORKFLOW_MAX_EVENTS=200
WORKFLOW_MAX_RETAINED_RUNS=500
WORKFLOW_MAX_RESULT_BYTES=65536
WORKFLOW_MAX_STORAGE_BYTES=67108864
# UI behavior
# Set false while editing the UI to prevent backdrop/outside clicks from closing panels.
# Escape and explicit close buttons always remain enabled.
OUTSIDE_CLICK_DISMISS=true
